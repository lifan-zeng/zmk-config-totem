//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/totem.h"

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define FUN  4

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4 LB5  // left hand
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4 RB5  // right hand
#define KEYS_T LH0 LH1 LH2 RH0 RH1 RH2                                          // thumbs

#include "includes/behaviors_homerow_mods.dtsi"
#include "includes/settings.dtsi"
#include "includes/behaviors_mod_morph.dtsi"

/ {
    behaviors {
        swapper: swapper {
            compatible = "zmk,behavior-smart-toggle";
            #binding-cells = <0>;
            bindings = <&kp LGUI>, <&kp TAB>;
            ignored-key-positions = <16>;
        };
    };
    combos {
        compatible = "zmk,combos";
        combo_nav {
            timeout-ms = <50>;
            key-positions = <33 34>;
            bindings = <&mo 1>;
        };
        combo_fun {
            timeout-ms = <50>;
            key-positions = <35 36>;
            bindings = <&mo 4>;
        };
        combo_esc {
            timeout-ms = <30>;
            key-positions = <2 3>;
            bindings = <&kp ESC>;
        };
        combo_tab {
            timeout-ms = <30>;
            key-positions = <23 24>;
            bindings = <&kp TAB>;
        };
        combo_cancel {
            timeout-ms = <30>;
            key-positions = <27 28>;
            bindings = <&kp K_CANCEL>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "BASE";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            /*
                                                                       ╭╮╭╮╭╮╭╮
                                                                       │╰╯╰╯╰╯│
                        ┌─────────┬─────────┬─────────┬─────────┬──────╨──┐┌──╨──────┬─────────┬─────────┬─────────┬─────────┐
                ╌┄┈┈───═╡    Q    │    W    │    E    │    R    │    T    ││    Y    │    U    │    I    │    O    │    P    │   
                        ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
                        │    A    │    S    │    D    │    F    │    G    ││    H    │    J    │    K    │    L    │    '    │    
              ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
              │   ESC   │    Z    │    X    │    C    │    V    │    B    ││    N    │    M    │    ,    │    .    │    /    │ CANCEL  │
              └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                            │   NUM   │  SPACE  │   SYM   ││  SHIFT  │  BSPC   │   RET   │  
                                            └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┘*/ 

            bindings = <
                           &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P
                    &hm_l LCTRL A  &hm_l LALT S  &hm_l LGUI D  &hm_shift_l LSHFT F  &kp G  &kp H  &hm_shift_r RSHFT J &hm_r RGUI K  &hm_r RALT L  &hm_r RCTRL SQT
              &kp ESC      &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT   &kp SLASH  &kp K_CANCEL
                                          &cmd_tab_num    &kp SPACE  &sl SYM   &mm_shift_caps_word_r  &bspc_del  &lt NAV RET
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        nav_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "NAVI";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            /*
                                                                       ╭╮╭╮╭╮╭╮
                                                                       │╰╯╰╯╰╯│
                        ┌─────────┬─────────┬─────────┬─────────┬──────╨──┐┌──╨──────┬─────────┬─────────┬─────────┬─────────┐
                ╌┄┈┈───═╡   HOME  │   PGUP  │    ↑    │   PGDN  │  NewTab ││  INSERT │         │         │         │         │   
                        ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
                        │   END   │    ←    │    ↓    │    →    │  Reload ││   CAPS  │  shift  │   cmd   │   alt   │  ctrl   │    
              ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
              │   ESC   │  PvWin  │  NxWin  │  PvTab  │  NxTab  │  ClsTab ││         │         │         │         │         │         │
              └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                            │  CmdTab │  SPACE  │         ││    ▼    │    ▼    │    ▼    │  
                                            └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┘ */

            bindings = <
                          &kp HOME    &kp PG_UP   &kp UP     &kp PG_DN   &kp LG(T)     &kp INS      &none      &none      &none      &none
                          &kp END     &kp LEFT    &kp DOWN   &kp RIGHT   &kp LG(R)    &kp CAPS      &kp RSHFT  &kp RGUI   &kp RALT   &kp RCTRL
                &kp ESC   &kp LG(LS(GRAVE))   &kp LG(GRAVE)   &kp LG(LS(LBKT))  &kp LG(LS(RBKT))   &kp LG(W)    &none      &none      &none      &none      &none      &none
                                                    &swapper  &kp SPACE  &none     &trans     &trans     &trans
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        sim_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "SYM";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
/*
                                                                           ╭╮╭╮╭╮╭╮
                                                                           │╰╯╰╯╰╯│
                            ┌─────────┬─────────┬─────────┬─────────┬──────╨──┐┌──╨──────┬─────────┬─────────┬─────────┬─────────┐
                    ╌┄┈┈───═╡    !    │    @    │    #    │    $    │    %    ││    <    │    _    │    [    │    ]    │    >    │   
                            ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
                            │   ctrl  │   alt   │   cmd   │  shift  │    ^    ││    -    │    :    │    (    │    )    │    *    │    
                  ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
                  │         │    ~    │    |    │    &    │    `    │    \    ││    +    │    =    │    {    │    }    │    /    │    ;    │
                  └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                                │    ▼    │    ▼    │    ▼    ││    ;    │   BSPC  │   RET   │  
                                                └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┘ */

            bindings = <
                            &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT   &kp LT     &kp UNDER      &kp LBKT   &kp RBKT   &kp GT
                            &kp LCTRL  &kp LALT   &kp LGUI   &kp LSHFT  &kp CARET   &kp MINUS   &kp COLON   &kp LPAR   &kp RPAR   &kp STAR
                &none       &kp TILDE  &kp PIPE   &kp AMPS   &kp GRAVE  &kp BSLH    &kp PLUS  &kp EQUAL   &kp LBRC   &kp RBRC   &kp SLASH  &kp SEMI
                                                  &trans     &trans     &trans      &kp SEMI  &bspc_del   &kp RET
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        number_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "NUM";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
                /*   
                                                                           ╭╮╭╮╭╮╭╮
                                                                           │╰╯╰╯╰╯│
                            ┌─────────┬─────────┬─────────┬─────────┬──────╨──┐┌──╨──────┬─────────┬─────────┬─────────┬─────────┐
                    ╌┄┈┈───═╡ sel all │         │         │         │         ││    .    │    7    │    8    │    9    │    0    │   
                            ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
                            │  ctrl   │   alt   │   cmd   │  shift  │   find  ││    -    │    4    │    5    │    6    │    *    │    
                  ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
                  │ sel all │   undo  │   cut   │   copy  │  paste  │   redo  ││    +    │    1    │    2    │    3    │    /    │    ,    │
                  └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                                │    ▼    │    ▼    │    ▼    ││    ,    │   BSPC  │   RET   │  
                                                └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┘ */ 

            bindings = <
                            &kp LG(A)      &none      &none      &none      &none      &kp DOT      &kp N7     &kp N8     &kp N9     &kp N0
                            &kp LCTRL  &kp LALT   &kp LGUI   &kp LSHFT  &kp LG(F)      &kp MINUS   &kp N4     &kp N5     &kp N6     &kp ASTERISK
                &kp LG(A)   &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(LS(Z))   &kp PLUS  &kp N1     &kp N2     &kp N3     &kp SLASH   &kp COMMA
                                                  &trans     &trans     &trans     &kp COMMA  &bspc_del   &kp RET
            >;
        };
        function_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "FUNC";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 /*
                                                                           ╭╮╭╮╭╮╭╮
                                                                           │╰╯╰╯╰╯│
                            ┌─────────┬─────────┬─────────┬─────────┬──────╨──┐┌──╨──────┬─────────┬─────────┬─────────┬─────────┐
                    ╌┄┈┈───═╡    F1   │   F2    │    F3   │   F4    │   F5    ││   BL2   │  prev   │  play   │  next   │         │   
                            ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
                            │    F6   │   F7    │   F8    │   F9    │   F10   ││   BL1   │  shift  │   cmd   │   alt   │   ctrl  │   
                  ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
                  │   ESC   │   F11   │   F12   │   Bri-  │   Bri+  │ BT_CLR  ││   BL0   │   vol-  │   vol+  │  mute   │         │         │
                  └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                                │    ▼    │    ▼    │    ▼    ││    ▼    │    ▼    │    ▼    │  
                                                └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┘ */ 

                        bindings = <
                            &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &bt BT_SEL 2  &kp C_PREV   &kp C_PP   &kp C_NEXT   &none
                            &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &bt BT_SEL 1  &kp RSHFT    &kp RGUI   &kp RALT   &kp RCTRL
                &kp ESC     &kp F11    &kp F12 &kp C_BRI_DEC &kp C_BRI_INC &bt BT_CLR   &bt BT_SEL 0  &kp C_VOL_DN &kp C_VOL_UP   &kp C_MUTE  &none     &none
                                                  &trans    &trans  &trans    &trans        &trans     &trans
            >;
        };
    };
};

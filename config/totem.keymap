//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define NUM  3
#define FUN  4

&sk {
    release-after-ms = <2000>;
    quick-release;
    /delete-property/ ignore-modifiers;
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_nav {
            timeout-ms = <50>;
            key-positions = <33 34>;
            bindings = <&mo 1>;
        };

        combo_key_repeat {
            timeout-ms = <50>;
            key-positions = <32 33>;
            bindings = <&key_repeat>;
        }
    };
    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "BASE";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            /*
                                                                       ╭╮╭╮╭╮╭╮
                                                                       │╰╯╰╯╰╯│
                        ┌─────────┬─────────┬─────────┬─────────┬──────╨──┐┌──╨──────┬─────────┬─────────┬─────────┬─────────┐
                ╌┄┈┈───═╡    Q    │    W    │    E    │    R    │    T    ││    Y    │    U    │    I    │    O    │    P    │   
                        ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
                        │    A    │    S    │    D    │    F    │    G    ││    H    │    J    │    K    │    L    │    '    │    
              ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
              │  SHIFT  │    Z    │    X    │    C    │    V    │    B    ││    N    │    M    │    ,    │    .    │    /    │  SHIFT  │
              └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                            │   ESC   │  SPACE  │   TAB   ││  ENTER  │   BSPC  │   DEL   │  
                                            └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┘*/ 

            bindings = <
                           &kp Q      &kp W      &kp E      &kp R      &kp T      &kp Y      &kp U      &kp I      &kp O      &kp P
                           &kp A      &kp S      &kp D      &kp F      &kp G      &kp H      &kp J      &kp K      &kp L      &kp SQT
              &kp LSHFT    &kp Z      &kp X      &kp C      &kp V      &kp B      &kp N      &kp M      &kp COMMA  &kp DOT   &kp SLASH  &kp RSHFT
                                          &lt SYM ESC    &kp SPACE  &lt NUM TAB  &lt NAV RET  &kp BSPC  &lt FUN DEL
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        nav_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "NAVI";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            /*
                                                                       ╭╮╭╮╭╮╭╮
                                                                       │╰╯╰╯╰╯│
                        ┌─────────┬─────────┬─────────┬─────────┬──────╨──┐┌──╨──────┬─────────┬─────────┬─────────┬─────────┐
                ╌┄┈┈───═╡   HOME  │   PGUP  │    ↑    │   PGDN  │  INSERT ││         │         │         │         │         │   
                        ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
                        │   END   │    ←    │    ↓    │    →    │   CAPS  ││         │  shift  │   cmd   │   alt   │  ctrl   │    
              ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
              │         │  PvTab  │  NxTab  │  PvWin  │  NxWin  │         ││         │         │         │         │         │         │
              └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                            │   ESC   │  SPACE  │   TAB   ││    ▼    │    ▼    │    ▼    │  
                                            └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┘ */

            bindings = <
                            &kp HOME    &kp PG_UP   &kp UP     &kp PG_DN   &kp INS     &none      &none      &none      &none      &none
                            &kp END     &kp LEFT    &kp DOWN   &kp RIGHT   &kp CAPS    &none      &sk RSHFT  &sk RGUI   &sk RALT   &sk RCTRL
                &none       &kp LG(LS(LBKT))   &kp LG(LS(RBKT))   &kp LG(LS(TAB))  &kp LG(TAB)   &none    &none      &none      &none      &none      &none      &none
                                                    &kp ESC    &kp SPACE   &kp TAB     &trans     &trans     &trans
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        sim_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "SYM";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
/*
                                                                           ╭╮╭╮╭╮╭╮
                                                                           │╰╯╰╯╰╯│
                            ┌─────────┬─────────┬─────────┬─────────┬──────╨──┐┌──╨──────┬─────────┬─────────┬─────────┬─────────┐
                    ╌┄┈┈───═╡    !    │    @    │    #    │    $    │    %    ││    [    │    <    │    =    │    >    │    ]    │   
                            ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
                            │   ctrl  │   alt   │   cmd   │  shift  │    ^    ││    {    │    (    │    :    │    )    │    }    │    
                  ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
                  │    \    │    `    │    ~    │    ;    │    _    │         ││    &    │    *    │    +    │    -    │    /    │    |    │
                  └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                                │    ▼    │    ▼    │    ▼    ││  ENTER  │   BSPC  │   DEL   │  
                                                └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┘ */

            bindings = <
                            &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT   &kp LBKT   &kp LT     &kp EQUAL  &kp GT     &kp RBKT
                            &sk LCTRL  &sk LALT   &sk LGUI   &sk LSHFT  &kp CARET   &kp LBRC   &kp LPAR   &kp COLON  &kp RPAR   &kp RBRC
                &kp BSLH    &kp GRAVE  &kp TILDE  &kp SEMI   &kp UNDER  &none       &kp AMPS   &kp ASTERISK &kp PLUS &kp MINUS &kp SLASH &kp PIPE
                                                  &trans     &trans     &trans      &kp ENTER  &kp BSPC   &kp DEL
            >;
        };

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        number_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "NUM";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
                /*   
                                                                           ╭╮╭╮╭╮╭╮
                                                                           │╰╯╰╯╰╯│
                            ┌─────────┬─────────┬─────────┬─────────┬──────╨──┐┌──╨──────┬─────────┬─────────┬─────────┬─────────┐
                    ╌┄┈┈───═╡         │         │         │         │         ││         │    7    │    8    │    9    │    0    │   
                            ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
                            │  ctrl   │   alt   │   cmd   │  shift  │         ││    +    │    4    │    5    │    6    │    *    │    
                  ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
                  │         │   undo  │   cut   │   copy  │  paste  │   redo  ││    -    │    1    │    2    │    3    │    /    │         │
                  └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                                │    ▼    │    ▼    │    ▼    ││  ENTER  │   BSPC  │   DEL   │  
                                                └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┘ */ 

            bindings = <
                            &none      &none      &none      &none      &none      &none      &kp N7     &kp N8     &kp N9     &kp N0
                            &sk LCTRL  &sk LALT   &sk LGUI   &sk LSHFT  &none      &kp PLUS   &kp N4     &kp N5     &kp N6     &kp ASTERISK
                &none       &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LG(V)  &kp LG(LS(Z))   &kp MINUS  &kp N1     &kp N2     &kp N3     &kp SLASH   &none
                                                  &trans     &trans     &trans     &kp ENTER  &kp BSPC   &kp DEL
            >;
        };
        function_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "FUNC";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
 /*
                                                                           ╭╮╭╮╭╮╭╮
                                                                           │╰╯╰╯╰╯│
                            ┌─────────┬─────────┬─────────┬─────────┬──────╨──┐┌──╨──────┬─────────┬─────────┬─────────┬─────────┐
                    ╌┄┈┈───═╡    F1   │   F2    │    F3   │   F4    │   F5    ││   BL2   │  prev   │  play   │  next   │         │   
                            ├─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┤
                            │    F6   │   F7    │   F8    │   F9    │   F10   ││   BL1   │  shift  │   cmd   │   alt   │   ctrl  │   
                  ┌─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┐
                  │         │   F11   │   F12   │         │         │         ││   BL0   │   vol-  │   vol+  │   mute  │         │         │
                  └─────────┴─────────┴─────────┼─────────┼─────────┼─────────┤├─────────┼─────────┼─────────┼─────────┴─────────┴─────────┘
                                                │   ESC   │  SPACE  │   TAB   ││    ▼    │    ▼    │    ▼    │  
                                                └─────────┴─────────┴─────────┘└─────────┴─────────┴─────────┘ */ 

                        bindings = <
                            &kp F1     &kp F2     &kp F3     &kp F4     &kp F5     &bt BT_SEL 2  &kp C_PREV   &kp C_PP   &kp C_NEXT   &none
                            &kp F6     &kp F7     &kp F8     &kp F9     &kp F10    &bt BT_SEL 1  &sk RSHFT    &sk RGUI   &sk RALT   &sk RCTRL
                &none       &kp F11    &kp F12    &none      &none      &none      &bt BT_SEL 0  &kp C_VOL_DN &kp C_VOL_UP   &kp C_MUTE  &none     &none
                                                  &kp ESC    &kp SPACE  &kp TAB    &trans        &trans     &trans
            >;
        };
    };
};
